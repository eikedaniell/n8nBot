    {
      "parameters": {
        "jsCode": "const media = $input.first().json; const original = $('Webhook').first().json.body.data; const caption = original.message?.imageMessage?.caption; const mimetype = media.mimetype || original.message?.imageMessage?.mimetype || 'image/jpeg'; const extensionMap = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' }; const ext = extensionMap[mimetype] || 'jpg'; let baseName; if (caption && caption.trim()) { baseName = caption.trim().replace(/[\\\\/:*?\"<>|]/g, '-'); } else { const now = new Date(); const pad = (n) => String(n).padStart(2, '0'); const dia = pad(now.getDate()); const mes = pad(now.getMonth() + 1); const ano = now.getFullYear(); const hora = pad(now.getHours()); const min = pad(now.getMinutes()); const seg = pad(now.getSeconds()); baseName = `${dia}${mes}${ano}${hora}${min}${seg}`; } const fileName = `${baseName}.${ext}`; const binaryData = await this.helpers.prepareBinaryData( Buffer.from(media.base64, 'base64'), fileName, mimetype ); return [{ json: { fileName }, binary: { data: binaryData } }];"
      },
