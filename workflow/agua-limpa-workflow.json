    {
      "parameters": {
        "jsCode": "const GRUPO_LOJA = '120363409721626552@g.us';\nconst results = [];\n\nfor (const item of $input.all()) {\n  const data = (item.json.body && item.json.body.data) || {};\n  const isGroupUpdate = item.json.body && item.json.body.event === 'group-participants.update';\n  const isGrupoCerto = data.id === GRUPO_LOJA || data.remoteJid === GRUPO_LOJA;\n  const isAdd = data.action === 'add';\n\n  if (isGroupUpdate && isGrupoCerto && isAdd) {\n    const participants = data.participants || [];\n    for (const p of participants) {\n      // Suporta os dois formatos possíveis: string simples OU objeto { phoneNumber }\n      const numero = typeof p === 'string' ? p : p.phoneNumber;\n      if (numero) {\n        results.push({ json: { numero, grupo: GRUPO_LOJA } });\n      }\n    }\n  }\n}\n\nreturn results;"
      },
